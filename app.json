{
  "expo": {
    "name": "FMI Airport Weather",
    "slug": "fmi-weather-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/fmi-weather-app-icon.png",
    "scheme": "fmiweatherapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/fmi-weather-app-icon.png",
      "bundleIdentifier": "com.xporampe.fmiweatherapp"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/fmi-weather-app-icon.png",
        "backgroundImage": "./assets/images/fmi-weather-app-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.xporampe.fmiweatherapp"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/fmi-weather-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/fmi-weather-app-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "-keep class androidx.work.** { *; }\n-keep class androidx.room.** { *; }"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "ec6fabcd-8ab1-4b2f-8427-909fc558b5ef"
      }
    }
  }
}
